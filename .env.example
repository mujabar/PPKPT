# ============================================================
# Contoh konfigurasi environment — JANGAN isi kredensial asli di sini.
# Salin file ini menjadi .env, lalu isi nilainya.
#   cp .env.example .env
# ============================================================

# Koneksi runtime aplikasi (Supabase connection pooler, port 6543).
# Ganti [PROJECT-REF], [REGION], dan [PASSWORD] dengan milik project Supabase.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Koneksi langsung untuk migrasi Prisma (port 5432, bukan pooler).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Kredensial Supabase (dipakai saat fitur auth/storage ditambahkan).
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
